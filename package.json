{
  "name": "petcare-firestore-security-tests",
  "private": true,
  "description": "Firestore Emulator security tests for PetCare+ adoption workflows",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-petcare \"node --test test/firestore/rules.test.mjs test/firestore/recipient_backfill_plan.test.mjs\"",
    "backfill:adoption-request-recipients": "node scripts/backfill-adoption-request-recipients.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^15.34.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
