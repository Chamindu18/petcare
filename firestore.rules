rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper Functions
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwner() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'owner';
    }

    function isVeterinarian() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'veterinarian';
    }

    function isVeterinaryStaff() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'veterinary_staff';
    }

    function isAdoptionProvider() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'adoption_provider';
    }

    function ownsPet(petId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/pets/$(petId)
        )
        && get(
          /databases/$(database)/documents/pets/$(petId)
        ).data.ownerId == request.auth.uid;
    }

    // Trusted users.vetId links an account to a directory record. Legacy
    // UID-keyed records are supported only with a matching userId.
    function currentVeterinarianId() {
      let value = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('vetId', null);
      return value is string && value.size() > 0 ? value : request.auth.uid;
    }

    function isVeterinarianForHospital(hospitalId) {
      let vetId = currentVeterinarianId();
      let directoryPath = /databases/$(database)/documents/veterinarians/$(vetId);
      return isVeterinarian()
        && hospitalId is string && hospitalId.size() > 0
        && hospitalId != 'unassigned'
        && exists(directoryPath)
        && get(directoryPath).data.get('active', false) == true
        && get(directoryPath).data.get('userId', '') == request.auth.uid
        && get(directoryPath).data.get('vetId', vetId) == vetId
        && validVeterinarianAccount(vetId, hospitalId, request.auth.uid)
        && get(directoryPath).data.hospitalId == hospitalId
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('hospitalId', null) == hospitalId;
    }

    function assignedVeterinarian(data) {
      return isVeterinarian()
        && data.get('vetId', null) == currentVeterinarianId()
        && isVeterinarianForHospital(data.hospitalId);
    }

    function appointmentClinician(data) {
      return isVeterinaryStaffForHospital(data.hospitalId)
        || assignedVeterinarian(data);
    }

    function validVeterinarianAccount(vetId, hospitalId, userId) {
      let pathId = userId is string && userId.size() > 0 ? userId : '__invalid__';
      let path = /databases/$(database)/documents/users/$(pathId);
      return userId is string && userId.size() > 0 && exists(path)
        && get(path).data.get('role', '') == 'veterinarian'
        && get(path).data.get('hospitalId', null) == hospitalId
        && (get(path).data.get('vetId', null) == vetId
          || (get(path).data.get('vetId', null) == null && userId == vetId));
    }

    // Directory IDs are canonical; only trusted provisioning controls active
    // membership. Booking requires the matching provisioned doctor account.
    function validAppointmentVeterinarian(data) {
      let vetId = data.get('vetId', null);
      let pathId = vetId is string && vetId.size() > 0 ? vetId : '__invalid__';
      let path = /databases/$(database)/documents/veterinarians/$(pathId);
      return vetId is string && vetId.size() > 0
        && data.hospitalId is string && data.hospitalId.size() > 0
        && data.hospitalId != 'unassigned'
        && exists(path)
        && get(path).data.get('active', false) == true
        && get(path).data.hospitalId == data.hospitalId
        && get(path).data.get('vetId', vetId) == vetId
        && validVeterinarianAccount(vetId, data.hospitalId, get(path).data.get('userId', null));
    }

    // Staff access requires a trusted assignment document keyed by the
    // authenticated UID. Inactive and unassigned records grant no access.
    function isVeterinaryStaffForHospital(hospitalId) {
      return signedIn()
        && hospitalId is string
        && hospitalId != 'unassigned'
        && isVeterinaryStaff()
        && exists(
          /databases/$(database)/documents/hospital_staff/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/hospital_staff/$(request.auth.uid)
        ).data.get('userId', '') == request.auth.uid
        && get(
          /databases/$(database)/documents/hospital_staff/$(request.auth.uid)
        ).data.get('hospitalId', null) == hospitalId
        && get(
          /databases/$(database)/documents/hospital_staff/$(request.auth.uid)
        ).data.get('active', false) == true;
    }

    // Shared hospital-scoped access is limited to appointment and queue
    // workflows. Other resources use the narrower veterinarian predicate.
    function isVeterinaryUserForHospital(hospitalId) {
      return isVeterinarianForHospital(hospitalId)
        || isVeterinaryStaffForHospital(hospitalId);
    }

    // Queue records are hospital-wide for staff, but veterinarians may only
    // access records assigned to their own directory identity.
    function isAssignedQueueVeterinarian(data) {
      return isVeterinarianForHospital(data.get('hospitalId', null))
        && data.get('veterinarianId', '') == currentVeterinarianId();
    }

    function isQueueManager(data) {
      return isVeterinaryStaffForHospital(data.get('hospitalId', null))
        || isAssignedQueueVeterinarian(data);
    }

    // ============================================================
    // Users
    // ============================================================

    match /users/{uid} {
      // Users can read only their own profile.
      allow read: if isCurrentUser(uid);

      // Public registration can create owner profiles only.
      // Require the complete, supported document schema.
      allow create: if isCurrentUser(uid)
        && request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'displayName',
          'email',
          'phone',
          'role',
          'notificationEnabled',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'displayName',
          'email',
          'phone',
          'role',
          'notificationEnabled',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'owner'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName
          == request.resource.data.fullName
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.notificationEnabled is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Allow only approved profile updates.
      // UID, role, email, creation time, and arbitrary fields
      // cannot be changed by client-side updates.
      allow update: if isCurrentUser(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'fullName',
            'displayName',
            'phone',
            'notificationEnabled',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['fullName', 'displayName'])
          || (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAll(['fullName', 'displayName'])
            && request.resource.data.fullName is string
            && request.resource.data.fullName.size() > 0
            && request.resource.data.displayName is string
            && request.resource.data.displayName
              == request.resource.data.fullName
          )
        )
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['phone'])
          || request.resource.data.phone is string
        )
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['notificationEnabled'])
          || request.resource.data.notificationEnabled is bool
        );

      // Client-side profile deletion is disabled until a coordinated
      // Firebase Authentication and Firestore deletion workflow exists.
      allow delete: if false;
    }

    // ============================================================
    // Pets
    // ============================================================

    match /pets/{petId} {
      // Veterinary access requires a separate appointment/QR authorization flow.
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isOwner()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner()
        && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // Medical Conditions
    // ============================================================

    match /medical_conditions/{conditionId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Vaccinations
    // ============================================================

    match /vaccinations/{vaccinationId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Treatments
    // ============================================================

    match /treatments/{treatmentId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Health Measurements
    // ============================================================

    match /health_measurements/{measurementId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Hospitals
    // ============================================================

    match /hospitals/{hospitalId} {
      // Hospital discovery is available to authenticated users.
      allow read: if signedIn();

      // Hospital creation is reserved for trusted provisioning/Admin SDK.
      allow create: if false;

      // Hospital configuration is veterinarian-managed, not staff-managed.
      allow update, delete: if isVeterinarianForHospital(hospitalId);
    }

    // ============================================================
    // Services
    // ============================================================

    match /services/{serviceId} {
      allow read: if signedIn();

      // Service documents must contain a hospitalId field. Until the app's
      // service model/writers provide that field, client writes fail closed.
      allow create: if request.resource.data.hospitalId is string
        && isVeterinarianForHospital(request.resource.data.hospitalId);

      allow update: if resource.data.hospitalId is string
        && isVeterinarianForHospital(resource.data.hospitalId)
        && request.resource.data.hospitalId == resource.data.hospitalId;

      allow delete: if resource.data.hospitalId is string
        && isVeterinarianForHospital(resource.data.hospitalId);
    }

    // ============================================================
    // Hospital Staff Assignments
    // ============================================================

    match /hospital_staff/{staffUid} {
      // A staff account may read its own assignment to resolve its hospital.
      // Inactive assignments remain readable so the app can explain access state.
      allow get: if isCurrentUser(staffUid) && isVeterinaryStaff();

      // Staff cannot enumerate assignments or provision/change their access.
      allow list, create, update, delete: if false;
    }

    // ============================================================
    // Veterinarians
    // ============================================================

    match /veterinarians/{veterinarianId} {
      allow read: if signedIn();

      // A veterinarian may create only their own initially unassigned
      // profile. Assigning a real hospital requires trusted provisioning.
      allow create: if isVeterinarian()
        && veterinarianId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.hospitalId == 'unassigned'
        && request.resource.data.get('active', false) == false;

      // Users cannot alter their identity or hospital assignment themselves.
      allow update: if isVeterinarian()
        && veterinarianId == currentVeterinarianId()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'fullName', 'profileImageUrl', 'specialty', 'qualifications',
          'experienceYears', 'bio', 'updatedAt'
        ]);

      allow delete: if isVeterinarian()
        && veterinarianId == request.auth.uid;
    }

    // ============================================================
    // Appointments
    // ============================================================

    // Keep appointment identity and ownership relationships immutable.
    function appointmentIdentityIsPreserved() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Owners may edit pending notes directly. Slot changes use the trusted
    // scheduler; status changes use the dedicated transition predicates below.
    function ownerCanEditPendingAppointment() {
      return isOwner()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == resource.data.status
        && resource.data.get('queueId', null) == null
        && validAppointmentVeterinarian(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && appointmentIdentityIsPreserved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reason',
          'updatedAt'
        ]);
    }

    // Only the appointment owner can cancel a pending or confirmed appointment.
    // The update must contain no other appointment-field changes.
    function ownerCanCancelAppointment() {
      return isOwner()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'cancelled'
        && appointmentIdentityIsPreserved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    // Assigned staff and veterinarians may confirm or reject pending appointments.
    // A status decision cannot be combined with edits to other appointment fields.
    function veterinaryUserCanDecideAppointment() {
      return appointmentClinician(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'rejected']
        && (request.resource.data.status == 'rejected'
          || validAppointmentVeterinarian(request.resource.data))
        && appointmentIdentityIsPreserved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    // Hospital users may edit notes without changing status or relationships.
    // All scheduling mutations must use the trusted transaction service.
    function veterinaryUserCanEditAppointmentDetails() {
      return appointmentClinician(resource.data)
        && (request.resource.data.vetId == resource.data.vetId
          || isVeterinaryStaffForHospital(resource.data.hospitalId))
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == resource.data.status
        && resource.data.get('queueId', null) == null
        && validAppointmentVeterinarian(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && appointmentIdentityIsPreserved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reason',
          'updatedAt'
        ]);
    }

    // Queue linkage requires a newly created, matching queue record
    // in the same atomic batch or transaction.
    function veterinaryUserCanLinkQueue(appointmentId) {
      let queueId = request.resource.data.get('queueId', null);
      // Let bindings evaluate eagerly; malformed IDs must not form invalid paths.
      let pathId = queueId is string && queueId.size() > 0
        ? queueId : '__invalid__';
      let queuePath =
        /databases/$(database)/documents/queue_records/$(pathId);

      return appointmentClinician(resource.data)
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'confirmed'
        && appointmentIdentityIsPreserved()
        && resource.data.get('queueId', null) == null
        && queueId is string
        && queueId.size() > 0
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['queueId', 'updatedAt'])
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasAll(['queueId'])
        && request.resource.data.updatedAt == request.time
        && !exists(queuePath)
        && existsAfter(queuePath)
        && getAfter(queuePath).data.queueId == queueId
        && getAfter(queuePath).data.appointmentId == appointmentId
        && getAfter(queuePath).data.hospitalId
          == resource.data.hospitalId
        && getAfter(queuePath).data.ownerId == resource.data.ownerId
        && getAfter(queuePath).data.petId == resource.data.petId;
    }

    // Privacy-preserving availability projection. No owner, pet or reason.
    function scheduleMatchesAppointment(appointmentId, data) {
      let appointment = getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data;
      return data.keys().hasOnly(['vetId', 'hospitalId', 'serviceId', 'dateTime', 'status', 'durationMinutes'])
        && data.get('durationMinutes', null) == appointment.get('durationMinutes', null)
        && data.vetId == appointment.vetId
        && data.hospitalId == appointment.hospitalId
        && data.serviceId == appointment.serviceId
        && data.dateTime == appointment.dateTime
        && data.status == appointment.status;
    }

    function appointmentScheduleIsConsistent(appointmentId) {
      let path = /databases/$(database)/documents/appointment_schedule/$(appointmentId);
      // Legacy appointments remain operable until their first projected update.
      return !exists(path)
        || (existsAfter(path)
          && scheduleMatchesAppointment(appointmentId, getAfter(path).data));
    }

    match /appointment_schedule/{appointmentId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && scheduleMatchesAppointment(appointmentId, request.resource.data)
        && (getAfter(/databases/$(database)/documents/appointments/$(appointmentId))
              .data.ownerId == request.auth.uid
          || appointmentClinician(getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data));
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.ownerId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/appointments/$(appointmentId));
    }

    // Server-only mutex, one per canonical veterinarian ID. No PII or client
    // reads/writes; Admin transactions use it to serialize schedule mutations.
    match /appointment_booking_locks/{vetId} {
      allow read, write: if false;
    }

    match /appointments/{appointmentId} {
      // Owners can read their own appointments. Active staff and assigned
      // veterinarians can read appointments in their hospital. List queries
      // must include a matching hospitalId filter for Firestore to prove scope.
      allow read: if signedIn()
        && (
          resource.data.get('ownerId', null) == request.auth.uid
          || isVeterinaryStaffForHospital(resource.data.get('hospitalId', null))
          || assignedVeterinarian(resource.data)
        );

      // Scheduling is trusted-server-only: client batches/transactions cannot
      // prove absence of overlapping query results. The callable verifies the
      // same owner, staff and directory relationships inside its transaction.
      allow create: if false;

      // Keep ordinary edits separate from status transitions. This prevents
      // owners from self-confirming and hospital users from self-cancelling.
      // Select queue linkage exclusively: a failed linkage must not evaluate
      // every ordinary-edit authorization branch and exhaust the expression
      // budget. The selected predicate still enforces the full authorization.
      allow update: if signedIn()
        && appointmentScheduleIsConsistent(appointmentId)
        && (request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['queueId'])
          ? veterinaryUserCanLinkQueue(appointmentId)
          : (
              (
                resource.data.get('ownerId', null) == request.auth.uid
                && resource.data.status == 'pending'
                && request.resource.data.status == 'pending'
                && ownerCanEditPendingAppointment()
              )
              || (
                resource.data.get('ownerId', null) == request.auth.uid
                && request.resource.data.status == 'cancelled'
                && ownerCanCancelAppointment()
              )
              || (
                resource.data.status == 'pending'
                && request.resource.data.status in ['confirmed', 'rejected']
                && veterinaryUserCanDecideAppointment()
              )
              || (
                resource.data.status in ['pending', 'confirmed']
                && request.resource.data.status == resource.data.status
                && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'vetId',
                    'dateTime',
                    'reason',
                    'updatedAt'
                  ])
                && veterinaryUserCanEditAppointmentDetails()
              )
          ));

      // Retain the existing owner deletion policy. Cancellation is preferred
      // for preserving appointment history and associated queue references.
      allow delete: if isOwner()
        && resource.data.ownerId == request.auth.uid
        && resource.data.get('queueId', null) == null
        && !existsAfter(/databases/$(database)/documents/appointment_schedule/$(appointmentId));
    }

    // ============================================================
    // Queue Records
    // ============================================================

    // queue_days is an atomic allocation ledger, one document per hospital/day.
    // day is UTC midnight representing the Asia/Colombo calendar date.
    function queueDateKey(day) {
      return string(day.year()) + '-'
        + (day.month() < 10 ? '0' : '') + string(day.month()) + '-'
        + (day.day() < 10 ? '0' : '') + string(day.day());
    }

    function appointmentIsToday(value, day) {
      let today = queueDateKey(day);
      let yesterday = queueDateKey(day - duration.value(1, 'd'));
      // Existing models store either local wall time (no suffix) or UTC Z.
      return (value is timestamp
          && (value + duration.value(330, 'm')).date() == day)
        || (value is string && (
        value.matches(today + 'T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?')
        || value.matches(today + 'T(0[0-9]|1[0-7]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z')
        || value.matches(today + 'T18:[0-2][0-9]:[0-5][0-9](\\.[0-9]+)?Z')
        || value.matches(yesterday + 'T(18:[3-5][0-9]|19:[0-5][0-9]|2[0-3]:[0-5][0-9]):[0-5][0-9](\\.[0-9]+)?Z')
      ));
    }

    function validQueueAllocation(data) {
      let key = data.dayKey is string ? data.dayKey : '__invalid__';
      let counterPath = /databases/$(database)/documents/hospitals/$(data.hospitalId)/queue_days/$(key);
      return data.day is timestamp
        && data.day == (request.time + duration.value(330, 'm')).date()
        && data.dayKey == queueDateKey(data.day)
        && data.updatedAt == request.time
        && getAfter(counterPath).data.lastNumber == data.queueNumber
        && getAfter(counterPath).data.queueId == data.queueId
        && getAfter(counterPath).data.updatedAt == request.time;
    }

    function validQueueDay(hospitalId, dayKey) {
      let data = request.resource.data;
      let queueId = data.get('queueId', null);
      let pathId = queueId is string && queueId.size() > 0 ? queueId : '__invalid__';
      let queuePath = /databases/$(database)/documents/queue_records/$(pathId);
      return data.keys().hasOnly(['lastNumber', 'queueId', 'day', 'updatedAt'])
        && data.keys().hasAll(['lastNumber', 'queueId', 'day', 'updatedAt'])
        && data.lastNumber is int && data.lastNumber > 0
        && data.queueId is string && data.queueId.size() > 0
        && data.day is timestamp
        && data.day == (request.time + duration.value(330, 'm')).date()
        && dayKey == queueDateKey(data.day)
        && data.updatedAt == request.time
        && !exists(queuePath)
        && existsAfter(queuePath)
        && getAfter(queuePath).data.hospitalId == hospitalId
        && getAfter(queuePath).data.dayKey == dayKey
        && getAfter(queuePath).data.queueNumber == data.lastNumber;
    }

    match /hospitals/{hospitalId}/queue_days/{dayKey} {
      allow read: if isVeterinaryUserForHospital(hospitalId);
      allow create: if isVeterinaryUserForHospital(hospitalId)
        && validQueueDay(hospitalId, dayKey) && request.resource.data.lastNumber == 1;
      allow update: if isVeterinaryUserForHospital(hospitalId)
        && validQueueDay(hospitalId, dayKey)
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }

    // A queue record must refer to a real, confirmed appointment.
    // Both identity relationships and hospital membership must match.
    //
    // getAfter() requires the appointment to be linked to this queue
    // in the same atomic batch/transaction.
    function validQueueCreation(queueId) {
      let data = request.resource.data;
      let appointmentId = data.get('appointmentId', null);
      let pathId = appointmentId is string && appointmentId.size() > 0
        ? appointmentId : '__invalid__';
      let appointmentPath =
        /databases/$(database)/documents/appointments/$(pathId);

      return data.keys().hasAll([
          'queueId',
          'appointmentId',
          'hospitalId',
          'ownerId',
          'petId',
          'veterinarianId',
          'queueNumber',
          'currentServing',
          'position',
          'status',
          'createdAt',
          'updatedAt',
          'day',
          'dayKey'
        ])
        && data.keys().hasOnly(['queueId', 'appointmentId', 'hospitalId', 'ownerId', 'petId', 'veterinarianId', 'queueNumber', 'currentServing', 'position', 'status', 'createdAt', 'updatedAt', 'day', 'dayKey'])
        && validQueueAllocation(data)
        && data.ownerId is string && data.ownerId.size() > 0
        && data.petId is string && data.petId.size() > 0
        && data.veterinarianId is string && data.veterinarianId.size() > 0
        && data.queueId == queueId
        && data.appointmentId is string
        && data.appointmentId.size() > 0
        && data.status == 'waiting'
        && data.queueNumber is int
        && data.queueNumber > 0
        && data.currentServing is int
        && data.currentServing >= 0
        && data.position is int
        && data.position >= 0
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && exists(appointmentPath)
        && appointmentIsToday(get(appointmentPath).data.dateTime, data.day)
        && get(appointmentPath).data.vetId is string
        && get(appointmentPath).data.vetId.size() > 0
        && get(appointmentPath).data.vetId == data.veterinarianId
        && get(appointmentPath).data.status == 'confirmed'
        && get(appointmentPath).data.get('queueId', null) == null
        && get(appointmentPath).data.hospitalId == data.hospitalId
        && get(appointmentPath).data.ownerId == data.ownerId
        && get(appointmentPath).data.petId == data.petId
        && getAfter(appointmentPath).data.get('queueId', null) == queueId;
    }

    // The lifecycle is waiting -> called -> in_consultation -> completed.
    // Active entries may instead be skipped or cancelled exactly once.
    function validQueueTransition() {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return (before == 'waiting' && after in ['called', 'skipped', 'cancelled'])
        || (before == 'called' && after in ['in_consultation', 'skipped', 'cancelled'])
        || (before == 'in_consultation' && after in ['completed', 'cancelled']);
    }

    // Each transition stamps exactly its own lifecycle timestamp.
    function validQueueTransitionFields() {
      let status = request.resource.data.status;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (status == 'called'
          && request.resource.data.get('calledAt', null) == request.time
          && changed.hasOnly([
            'status',
            'currentServing',
            'position',
            'updatedAt',
            'calledAt'
          ]))
        || (status == 'in_consultation'
          && request.resource.data.get('consultationStartedAt', null) == request.time
          && changed.hasOnly([
            'status',
            'currentServing',
            'position',
            'updatedAt',
            'consultationStartedAt'
          ]))
        || (status == 'completed'
          && request.resource.data.get('completedAt', null) == request.time
          && changed.hasOnly([
            'status',
            'currentServing',
            'position',
            'updatedAt',
            'completedAt'
          ]))
        || (status == 'skipped'
          && request.resource.data.get('skippedAt', null) == request.time
          && changed.hasOnly([
            'status',
            'currentServing',
            'position',
            'updatedAt',
            'skippedAt'
          ]))
        || (status == 'cancelled'
          && request.resource.data.get('cancelledAt', null) == request.time
          && changed.hasOnly([
            'status',
            'currentServing',
            'position',
            'updatedAt',
            'cancelledAt'
          ]));
    }

    function queueTimestampFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'calledAt',
        'consultationStartedAt',
        'completedAt',
        'skippedAt',
        'cancelledAt'
      ]);
    }

    match /queue_records/{queueId} {
      // Owners retain owner-scoped reads. Staff can read the hospital queue,
      // while veterinarians can read only their assigned queue records.
      allow read: if signedIn()
        && (
          resource.data.get('ownerId', null) == request.auth.uid
          || isQueueManager(resource.data)
        );

      // A valid appointment and atomic appointment linkage are
      // mandatory for queue creation.
      allow create: if isQueueManager(request.resource.data)
        && validQueueCreation(queueId);

      // Preserve queue identities and assigned queue numbers.
      // A status change must move exactly one stage forward.
      allow update: if isQueueManager(resource.data)
        && request.resource.data.queueId == resource.data.queueId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.appointmentId
          == resource.data.appointmentId
        && request.resource.data.hospitalId
          == resource.data.hospitalId
        && request.resource.data.queueNumber
          == resource.data.queueNumber
        && request.resource.data.currentServing is int
        && request.resource.data.currentServing >= 0
        && request.resource.data.position is int
        && request.resource.data.position >= 0
        && request.resource.data.status is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status',
            'currentServing',
            'position',
            'updatedAt',
            'calledAt',
            'consultationStartedAt',
            'completedAt',
            'skippedAt',
            'cancelledAt'
          ])
        && (
          (validQueueTransition() && validQueueTransitionFields())
          || (
            resource.data.status in [
              'waiting',
              'called',
              'in_consultation'
            ]
            && request.resource.data.status == resource.data.status
            && request.resource.data.currentServing
              == resource.data.currentServing
            && request.resource.data.position == resource.data.position
            && queueTimestampFieldsUnchanged()
          )
        );

      // Queue records are retained for audit/history purposes.
      allow delete: if false;
    }

    // ============================================================
    // Notifications
    // ============================================================

    function validOwnerNotification(data) {
      return data.keys().hasAll(['recipientUserId', 'type', 'message', 'read', 'targetType', 'targetId', 'createdAt'])
        && data.keys().hasOnly(['recipientUserId', 'type', 'message', 'read', 'targetType', 'targetId', 'createdAt', 'appointmentTime', 'queueNumber', 'listingName'])
        && data.recipientUserId is string
        && data.type is string
        && data.message is string
        && data.targetType is string
        && data.targetId is string
        && data.read == false
        && data.createdAt == request.time;
    }

    function validAppointmentNotification(data, notificationId) {
      let path = /databases/$(database)/documents/appointments/$(data.targetId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return data.targetType == 'appointment'
        && data.type in ['appointment_confirmed', 'appointment_rejected']
        && notificationId == data.type + '_' + data.targetId
        && data.recipientUserId == before.ownerId
        && data.keys().hasAll(['appointmentTime'])
        && !data.keys().hasAny(['queueNumber', 'listingName'])
        && data.appointmentTime == before.dateTime
        && before.ownerId == after.ownerId
        && before.petId == after.petId
        && before.hospitalId == after.hospitalId
        && before.createdAt == after.createdAt
        && appointmentClinician(before)
        && before.status == 'pending'
        && after.status == (data.type == 'appointment_confirmed' ? 'confirmed' : 'rejected')
        && after.updatedAt == request.time
        && data.message == (data.type == 'appointment_confirmed'
          ? 'Your appointment was confirmed.' : 'Your appointment was rejected.');
    }

    function queueNotificationTransitionMatches(type, before, after) {
      return (type == 'queue_called'
          && before == 'waiting' && after == 'called')
        || (type == 'queue_in_consultation'
          && before == 'called' && after == 'in_consultation')
        || (type == 'queue_completed'
          && before == 'in_consultation' && after == 'completed')
        || (type == 'queue_skipped'
          && before in ['waiting', 'called'] && after == 'skipped')
        || (type == 'queue_cancelled'
          && before in ['waiting', 'called', 'in_consultation']
          && after == 'cancelled');
    }

    function queueNotificationMessage(type) {
      return type == 'queue_checked_in'
        ? 'Your pet was checked in to the queue.'
        : type == 'queue_called'
        ? 'Your pet has been called to the consultation room.'
        : type == 'queue_in_consultation'
        ? 'Your pet\'s consultation has begun.'
        : type == 'queue_completed'
        ? 'Your pet\'s consultation is complete.'
        : type == 'queue_skipped'
        ? 'Your pet was skipped in the queue.'
        : 'Your pet\'s queue entry was cancelled.';
    }

    function validQueueNotification(data, notificationId) {
      let path = /databases/$(database)/documents/queue_records/$(data.targetId);
      let beforeExists = exists(path);
      let after = getAfter(path).data;
      return data.targetType == 'queue'
        && data.type in [
          'queue_checked_in',
          'queue_called',
          'queue_in_consultation',
          'queue_completed',
          'queue_skipped',
          'queue_cancelled'
        ]
        && notificationId == data.type + '_' + data.targetId
        && isQueueManager(after)
        && data.recipientUserId == after.ownerId
        && data.keys().hasAll(['queueNumber'])
        && !data.keys().hasAny(['appointmentTime', 'listingName'])
        && data.queueNumber == after.queueNumber
        && after.updatedAt == request.time
        && (data.type == 'queue_checked_in'
          ? (!beforeExists
            && after.status == 'waiting'
            && getAfter(/databases/$(database)/documents/appointments/$(after.appointmentId)).data.queueId == data.targetId)
          : (beforeExists
            && get(path).data.ownerId == after.ownerId
            && get(path).data.petId == after.petId
            && get(path).data.appointmentId == after.appointmentId
            && get(path).data.hospitalId == after.hospitalId
            && get(path).data.queueNumber == after.queueNumber
            && queueNotificationTransitionMatches(
              data.type,
              get(path).data.status,
              after.status
            )))
        && data.message == queueNotificationMessage(data.type);
    }

    function validAdoptionNotification(data, notificationId) {
      let path = /databases/$(database)/documents/adoption_requests/$(data.targetId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return data.targetType == 'adoption_request'
        && data.type in ['adoption_accepted', 'adoption_rejected']
        && notificationId == data.type + '_' + data.targetId
        && authorizedRequestRecipient(before)
        && data.recipientUserId == before.requesterId
        && !data.keys().hasAny(['appointmentTime', 'queueNumber'])
        && data.keys().hasAll(['listingName'])
        && data.listingName is string
        && data.listingName == get(/databases/$(database)/documents/adoption_listings/$(before.listingId)).data.petName
        && before.requesterId == after.requesterId
        && before.listingId == after.listingId
        && before.recipientId == after.recipientId
        && before.recipientType == after.recipientType
        && before.status == 'pending'
        && after.status == (data.type == 'adoption_accepted' ? 'accepted' : 'rejected')
        && after.updatedAt == request.time
        && data.message == (data.type == 'adoption_accepted'
          ? 'Your adoption request was accepted.' : 'Your adoption request was rejected.');
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientUserId == request.auth.uid;

      // A recipient can mark a notification as read, but cannot change its
      // recipient, content, target, type, or creation metadata.
      allow update: if signedIn()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.recipientUserId == resource.data.recipientUserId
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read'
        ]);

      allow create: if signedIn()
        && validOwnerNotification(request.resource.data)
        && (request.resource.data.targetType == 'appointment'
          ? validAppointmentNotification(request.resource.data, notificationId)
          : (request.resource.data.targetType == 'queue'
            ? validQueueNotification(request.resource.data, notificationId)
            : (request.resource.data.targetType == 'adoption_request'
              && validAdoptionNotification(request.resource.data, notificationId))));
      allow delete: if false;
    }

    // ============================================================
    // Adoption Listings
    // ============================================================

    function listingOwnerType(data) {
      // Legacy listings were provider-owned and only have providerId.
      return data.get('listingOwnerType', 'adoption_provider');
    }

    function listingOwnerId(data) {
      return data.get('listingOwnerId', data.get('providerId', ''));
    }

    function ownsListing(data) {
      return signedIn()
        && listingOwnerId(data) == request.auth.uid
        && (
          (listingOwnerType(data) == 'owner' && isOwner())
          ||
          (
            listingOwnerType(data) == 'adoption_provider'
            && isAdoptionProvider()
            && data.get('providerId', request.auth.uid) == request.auth.uid
          )
        );
    }

    function validListingFields(data) {
      return data.keys().hasAll([
          'listingOwnerType', 'listingOwnerId', 'petName', 'species',
          'gender', 'description', 'location', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'providerId', 'listingOwnerType', 'listingOwnerId', 'petName',
          'species', 'breed', 'ageDescription', 'gender', 'description',
          'location', 'imageAsset', 'status', 'contactNote', 'acceptedRequestId',
          'createdAt', 'updatedAt'
        ])
        && data.listingOwnerType in ['owner', 'adoption_provider']
        && data.listingOwnerId is string
        && data.petName is string
        && data.petName.size() > 0
        && data.species is string
        && data.gender is string
        && data.description is string
        && data.location is string
        && data.status in ['draft', 'available', 'reserved']
        && (
          (
            data.status == 'reserved'
            && data.get('acceptedRequestId', null) is string
            && data.get('acceptedRequestId', '').size() > 0
          )
          ||
          (
            data.status != 'reserved'
            && !data.keys().hasAny(['acceptedRequestId'])
          )
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['breed']) || data.breed is string)
        && (!data.keys().hasAny(['ageDescription']) || data.ageDescription is string)
        && (!data.keys().hasAny(['imageAsset']) || data.imageAsset is string)
        && (!data.keys().hasAny(['contactNote']) || data.contactNote is string);
    }

    // Older provider clients do not write canonical ownership fields. Their
    // compatibility path remains provider-only and still binds providerId to
    // the authenticated account. New owner listings never use this path.
    function validLegacyProviderListingFields(data) {
      return data.keys().hasAll([
          'providerId', 'petName', 'species', 'gender', 'description',
          'location', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'providerId', 'petName', 'species', 'breed', 'ageDescription',
          'gender', 'description', 'location', 'imageAsset', 'status',
          'contactNote', 'createdAt', 'updatedAt'
        ])
        && data.providerId is string
        && data.petName is string
        && data.petName.size() > 0
        && data.species is string
        && data.gender is string
        && data.description is string
        && data.location is string
        && data.status in ['draft', 'available']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['breed']) || data.breed is string)
        && (!data.keys().hasAny(['ageDescription']) || data.ageDescription is string)
        && (!data.keys().hasAny(['imageAsset']) || data.imageAsset is string)
        && (!data.keys().hasAny(['contactNote']) || data.contactNote is string);
    }

    function acceptedRequestMatchesReservation(listingId, requestId) {
      let acceptedRequest = getAfter(
        /databases/$(database)/documents/adoption_requests/$(requestId)
      ).data;
      return acceptedRequest.status == 'accepted'
        && acceptedRequest.listingId == listingId
        && acceptedRequest.recipientId == request.auth.uid
        && acceptedRequest.recipientType == listingOwnerType(resource.data)
        && acceptedRequest.acceptedAt == request.time
        && acceptedRequest.updatedAt == request.time;
    }

    function listingCanBeReserved(listingId) {
      return request.resource.data.status == 'reserved'
        && request.resource.data.get('acceptedRequestId', null) is string
        && request.resource.data.get('acceptedRequestId', '').size() > 0
        && ownsListing(resource.data)
        && resource.data.status == 'available'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedRequestId', 'updatedAt'
        ])
        && acceptedRequestMatchesReservation(
          listingId,
          request.resource.data.acceptedRequestId
        );
    }

    function normalListingCanBeUpdated() {
      return (
          ownsListing(resource.data)
          && validListingFields(request.resource.data)
          && request.resource.data.status in ['draft', 'available']
          && request.resource.data.listingOwnerType == listingOwnerType(resource.data)
          && request.resource.data.listingOwnerId == listingOwnerId(resource.data)
          && request.resource.data.get('providerId', '')
            == resource.data.get('providerId', '')
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'providerId', 'listingOwnerType', 'listingOwnerId', 'petName',
            'species', 'breed', 'ageDescription', 'gender', 'description',
            'location', 'imageAsset', 'status', 'contactNote', 'updatedAt'
          ])
        )
        || (
          // Compatibility for previously released provider clients.
          isAdoptionProvider()
          && resource.data.get('providerId', '') == request.auth.uid
          && request.resource.data.get('providerId', '')
            == resource.data.get('providerId', '')
          && request.resource.data.get('listingOwnerType', null)
            == resource.data.get('listingOwnerType', null)
          && request.resource.data.get('listingOwnerId', null)
            == resource.data.get('listingOwnerId', null)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            validListingFields(request.resource.data)
            || validLegacyProviderListingFields(request.resource.data)
          )
          && request.resource.data.status in ['draft', 'available']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'providerId', 'listingOwnerType', 'listingOwnerId', 'petName',
            'createdAt', 'species', 'breed', 'ageDescription', 'gender',
            'description', 'location', 'imageAsset', 'status', 'contactNote',
            'updatedAt'
          ])
        );
    }

    match /adoption_listings/{listingId} {
      // Signed-in users can browse published listings.
      // Only providers can read their own drafts.
      allow read: if signedIn()
        && (
          resource.data.status != 'draft'
          || (
            isAdoptionProvider()
            && ownsListing(resource.data)
          )
        );

      // Only adoption providers can create advertisements.
      allow create: if isAdoptionProvider()
        && (
          (
            validListingFields(request.resource.data)
            && request.resource.data.listingOwnerType == 'adoption_provider'
            && request.resource.data.listingOwnerId == request.auth.uid
            && request.resource.data.providerId == request.auth.uid
            && request.resource.data.status in ['draft', 'available']
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            validLegacyProviderListingFields(request.resource.data)
            && request.resource.data.providerId == request.auth.uid
          )
        );

      // Only adoption providers can update or reserve their listings.
      allow update: if isAdoptionProvider()
        && (
          request.resource.data.status == 'reserved'
            ? listingCanBeReserved(listingId)
            : normalListingCanBeUpdated()
        );

      // Listings are retained rather than hard-deleted.
      allow delete: if false;
    }

    // ============================================================
    // Adoption Requests
    // ============================================================

    // Canonical fields are populated by current clients or the trusted
    // backfill. This field-only predicate is suitable for list queries: it
    // lets Firestore prove query authorization without turning rules into a
    // post-query filter.
    function canonicalRequestRecipient(data) {
      return signedIn()
        && data.get('recipientId', '') == request.auth.uid
        && (
          (data.get('recipientType', '') == 'owner' && isOwner())
          ||
          (data.get('recipientType', '') == 'adoption_provider'
            && isAdoptionProvider())
        );
    }

    // Direct reads and decisions also verify that the canonical recipient
    // still owns the referenced listing. Do not fall back to providerId here:
    // an unbackfilled legacy record is not evidence of current ownership.
    function authorizedRequestRecipient(data) {
      return canonicalRequestRecipient(data)
        && data.listingId is string
        && exists(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        )
        && listingOwnerType(get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data) == data.recipientType
        && listingOwnerId(get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data) == data.recipientId;
    }

    function validNewAdoptionRequest(data) {
      return data.keys().hasAll([
        'listingId', 'requesterId', 'recipientId', 'recipientType',
        'status', 'submittedAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'listingId', 'requesterId', 'providerId', 'recipientId',
          'recipientType', 'message', 'status', 'submittedAt', 'updatedAt'
        ])
        && data.listingId is string
        && data.requesterId is string
        && data.requesterId == request.auth.uid
        && data.recipientId is string
        && data.recipientId != request.auth.uid
        && data.recipientType == 'adoption_provider'
        && data.status == 'pending'
        && data.submittedAt == request.time
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['message']) ||
          (data.message is string && data.message.size() <= 500))
        && exists(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        )
        && get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data.status == 'available'
        && listingOwnerType(get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data) == 'adoption_provider'
        && listingOwnerId(get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data) == data.recipientId
        && get(
          /databases/$(database)/documents/users/$(data.recipientId)
        ).data.role == 'adoption_provider'
        && data.get('providerId', '') == data.recipientId;
    }

    function ownerCanWithdrawRequest() {
      return isOwner()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.get('recipientId', null)
          == resource.data.get('recipientId', null)
        && request.resource.data.get('recipientType', null)
          == resource.data.get('recipientType', null)
        && request.resource.data.get('providerId', null)
          == resource.data.get('providerId', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'closedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.closedAt == request.time
        && request.resource.data.get('acceptedAt', null)
          == resource.data.get('acceptedAt', null);
    }

    function recipientCanDecideRequest(requestId) {
      return authorizedRequestRecipient(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.get('recipientId', null)
          == resource.data.get('recipientId', null)
        && request.resource.data.get('recipientType', null)
          == resource.data.get('recipientType', null)
        && request.resource.data.get('providerId', null)
          == resource.data.get('providerId', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'acceptedAt', 'closedAt', 'providerNote'
        ])
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['providerNote']) ||
          (request.resource.data.providerNote is string
            && request.resource.data.providerNote.size() <= 500))
        && (
          request.resource.data.status == 'accepted'
          ? (
              get(
                /databases/$(database)/documents/adoption_listings/$(resource.data.listingId)
              ).data.status == 'available'
              && getAfter(
                /databases/$(database)/documents/adoption_listings/$(resource.data.listingId)
              ).data.status == 'reserved'
              && getAfter(
                /databases/$(database)/documents/adoption_listings/$(resource.data.listingId)
              ).data.acceptedRequestId == requestId
              && request.resource.data.acceptedAt == request.time
              && request.resource.data.get('closedAt', null)
                == resource.data.get('closedAt', null)
          )
          : (
              request.resource.data.status == 'rejected'
              && request.resource.data.closedAt == request.time
              && request.resource.data.get('acceptedAt', null)
                == resource.data.get('acceptedAt', null)
          )
        );
    }

    // Previously released clients submit provider requests with only
    // providerId. Keep this path provider-only and validate it against the
    // current available listing before allowing creation.
    function validLegacyProviderRequest(data) {
      return data.keys().hasAll([
          'listingId', 'requesterId', 'providerId', 'status',
          'submittedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'listingId', 'requesterId', 'providerId', 'message', 'status',
          'submittedAt', 'updatedAt'
        ])
        && data.listingId is string
        && data.requesterId == request.auth.uid
        && data.providerId is string
        && data.providerId != request.auth.uid
        && data.status == 'pending'
        && data.submittedAt == request.time
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['message']) ||
          (data.message is string && data.message.size() <= 500))
        && exists(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        )
        && get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data.status == 'available'
        && listingOwnerType(get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data) == 'adoption_provider'
        && listingOwnerId(get(
          /databases/$(database)/documents/adoption_listings/$(data.listingId)
        ).data) == data.providerId
        && get(
          /databases/$(database)/documents/users/$(data.providerId)
        ).data.role == 'adoption_provider';
    }

    match /adoption_requests/{requestId} {
      // A direct recipient read also verifies the request's referenced listing.
      // Legacy requests become directly readable after the trusted backfill
      // writes canonical recipient fields for verified relationships.
      allow get: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || authorizedRequestRecipient(resource.data)
        );

      // List queries rely only on canonical recipient fields so Firestore can
      // prove the query is scoped to one recipient. The trusted backfill must
      // clear recipient fields on missing/mismatched legacy relationships
      // before this rule is rolled out; rules do not filter query results.
      allow list: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || canonicalRequestRecipient(resource.data)
        );

      allow create: if isOwner()
        && (validNewAdoptionRequest(request.resource.data)
          || validLegacyProviderRequest(request.resource.data));

      allow update: if request.resource.data.status == 'withdrawn'
        ? ownerCanWithdrawRequest()
        : recipientCanDecideRequest(requestId);

      // Withdrawal retains history; clients cannot physically delete requests.
      allow delete: if false;
    }

    // ============================================================
    // Default Deny
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
