rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper Functions
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwner() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'owner';
    }

    function isVeterinarian() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'veterinarian';
    }

    function isVeterinaryStaff() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'veterinary_staff';
    }

    function isVeterinaryUser() {
      return isVeterinarian() || isVeterinaryStaff();
    }

    function isAdoptionProvider() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'adoption_provider';
    }

    function ownsPet(petId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/pets/$(petId)
        )
        && get(
          /databases/$(database)/documents/pets/$(petId)
        ).data.ownerId == request.auth.uid;
    }

    // A veterinary role alone does not grant access to a hospital.
    // The user must have a provisioned veterinarian profile assigned to
    // that hospital. The sentinel value 'unassigned' grants no hospital access.
    function isVeterinaryUserForHospital(hospitalId) {
      return signedIn()
        && hospitalId is string
        && hospitalId != 'unassigned'
        && isVeterinaryUser()
        && exists(
          /databases/$(database)/documents/veterinarians/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/veterinarians/$(request.auth.uid)
        ).data.hospitalId == hospitalId;
    }

    // ============================================================
    // Users
    // ============================================================

    match /users/{uid} {
      // Users can read only their own profile.
      allow read: if isCurrentUser(uid);

      // Public registration creates an owner profile only.
      allow create: if isCurrentUser(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'owner';

      // Users can update their own profile but cannot change their UID or role.
      allow update: if isCurrentUser(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == resource.data.role;

      // Privileged profiles require trusted account-lifecycle handling.
      allow delete: if isCurrentUser(uid)
        && resource.data.role == 'owner';
    }

    // ============================================================
    // Pets
    // ============================================================

    match /pets/{petId} {
      // Veterinary access requires a separate appointment/QR authorization flow.
      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isOwner()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner()
        && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // Medical Conditions
    // ============================================================

    match /medical_conditions/{conditionId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Vaccinations
    // ============================================================

    match /vaccinations/{vaccinationId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Treatments
    // ============================================================

    match /treatments/{treatmentId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Health Measurements
    // ============================================================

    match /health_measurements/{measurementId} {
      allow read: if ownsPet(resource.data.petId);

      allow create: if isOwner()
        && ownsPet(request.resource.data.petId);

      allow update: if isOwner()
        && ownsPet(resource.data.petId)
        && request.resource.data.petId == resource.data.petId;

      allow delete: if isOwner()
        && ownsPet(resource.data.petId);
    }

    // ============================================================
    // Hospitals
    // ============================================================

    match /hospitals/{hospitalId} {
      // Hospital discovery is available to authenticated users.
      allow read: if signedIn();

      // Hospital creation is reserved for trusted provisioning/Admin SDK.
      allow create: if false;

      // Only veterinary users assigned to this hospital can manage it.
      allow update, delete: if isVeterinaryUserForHospital(hospitalId);
    }

    // ============================================================
    // Services
    // ============================================================

    match /services/{serviceId} {
      allow read: if signedIn();

      // Service documents must contain a hospitalId field. Until the app's
      // service model/writers provide that field, client writes fail closed.
      allow create: if request.resource.data.hospitalId is string
        && isVeterinaryUserForHospital(request.resource.data.hospitalId);

      allow update: if resource.data.hospitalId is string
        && isVeterinaryUserForHospital(resource.data.hospitalId)
        && request.resource.data.hospitalId == resource.data.hospitalId;

      allow delete: if resource.data.hospitalId is string
        && isVeterinaryUserForHospital(resource.data.hospitalId);
    }

    // ============================================================
    // Veterinarians / Veterinary Staff
    // ============================================================

    match /veterinarians/{veterinarianId} {
      allow read: if signedIn();

      // A veterinary user may create only their own initially unassigned
      // profile. Assigning a real hospital requires trusted provisioning.
      allow create: if isVeterinaryUser()
        && veterinarianId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.hospitalId == 'unassigned';

      // Users cannot alter their identity or hospital assignment themselves.
      allow update: if isVeterinaryUser()
        && veterinarianId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.hospitalId == resource.data.hospitalId;

      allow delete: if isVeterinaryUser()
        && veterinarianId == request.auth.uid;
    }

    // ============================================================
    // Appointments
    // ============================================================

    match /appointments/{appointmentId} {
      // Owners can read their own appointments; veterinary users can read
      // appointments associated with their provisioned hospital.
      allow read: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || isVeterinaryUserForHospital(resource.data.hospitalId)
        );

      // Owners can create appointments only for their own pets.
      allow create: if isOwner()
        && request.resource.data.ownerId == request.auth.uid
        && ownsPet(request.resource.data.petId);

      // Preserve appointment identity and restrict each role to its expected
      // mutable fields. Status-transition policy still needs workflow agreement.
      allow update: if signedIn()
        && (
          (
            isOwner()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.petId == resource.data.petId
            && request.resource.data.hospitalId == resource.data.hospitalId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'dateTime',
              'reason',
              'status',
              'vetId',
              'serviceId',
              'updatedAt'
            ])
          )
          ||
          (
            isVeterinaryUserForHospital(resource.data.hospitalId)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.petId == resource.data.petId
            && request.resource.data.hospitalId == resource.data.hospitalId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'vetId',
              'dateTime',
              'reason',
              'queueId',
              'updatedAt'
            ])
          )
        );

      allow delete: if isOwner()
        && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // Queue Records
    // ============================================================

    match /queue_records/{queueId} {
      allow read: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || isVeterinaryUserForHospital(resource.data.hospitalId)
        );

      // Queue creation is restricted to a veterinary user assigned to the
      // hospital named on the new queue record.
      allow create: if isVeterinaryUserForHospital(
        request.resource.data.hospitalId
      );

      // Immutable relationship fields cannot be reassigned during updates.
      // Queue state fields remain mutable for the hospital's veterinary users.
      allow update: if isVeterinaryUserForHospital(resource.data.hospitalId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.appointmentId == resource.data.appointmentId
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'queueNumber',
          'currentServing',
          'position',
          'updatedAt'
        ]);

      // Deletes authorize against the existing record. request.resource is
      // undefined for deletes and must not be used here.
      allow delete: if isVeterinaryUserForHospital(resource.data.hospitalId);
    }

    // ============================================================
    // Notifications
    // ============================================================

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientUserId == request.auth.uid;

      // A recipient can mark a notification as read, but cannot change its
      // recipient, content, target, type, or creation metadata.
      allow update: if signedIn()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.recipientUserId == resource.data.recipientUserId
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read'
        ]);

      // Notifications are created/deleted by trusted backend logic only.
      allow create, delete: if false;
    }

    // ============================================================
    // Adoption Listings
    // ============================================================

    match /adoption_listings/{listingId} {
      // Authenticated users can discover listings.
      allow read: if signedIn();

      allow create: if isAdoptionProvider()
        && request.resource.data.providerId == request.auth.uid;

      allow update: if isAdoptionProvider()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId;

      allow delete: if isAdoptionProvider()
        && resource.data.providerId == request.auth.uid;
    }

    // ============================================================
    // Adoption Requests
    // ============================================================

    match /adoption_requests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.providerId == request.auth.uid
        );

      // Requests must refer to an existing, available listing and the
      // provider recorded on that listing.
      allow create: if isOwner()
        && request.resource.data.requesterId == request.auth.uid
        && exists(
          /databases/$(database)/documents/adoption_listings/$(request.resource.data.listingId)
        )
        && get(
          /databases/$(database)/documents/adoption_listings/$(request.resource.data.listingId)
        ).data.providerId == request.resource.data.providerId
        && get(
          /databases/$(database)/documents/adoption_listings/$(request.resource.data.listingId)
        ).data.status == 'available';

      // The owner branch only permits updating updatedAt; withdrawal is
      // supported by the separate owner delete rule. Providers can update
      // decision/workflow fields without changing request relationships.
      allow update: if signedIn()
        && (
          (
            isOwner()
            && resource.data.requesterId == request.auth.uid
            && request.resource.data.requesterId == resource.data.requesterId
            && request.resource.data.providerId == resource.data.providerId
            && request.resource.data.listingId == resource.data.listingId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'updatedAt'
            ])
          )
          ||
          (
            isAdoptionProvider()
            && resource.data.providerId == request.auth.uid
            && request.resource.data.providerId == resource.data.providerId
            && request.resource.data.requesterId == resource.data.requesterId
            && request.resource.data.listingId == resource.data.listingId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'providerNote',
              'acceptedAt',
              'closedAt',
              'updatedAt'
            ])
          )
        );

      allow delete: if isOwner()
        && resource.data.requesterId == request.auth.uid;
    }

    // ============================================================
    // Default Deny
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
